/**
 * app.wxss —— 全局样式
 * 设计基调：简洁简约 —— 浅灰背景 + 白色圆角卡片 + 品牌蓝（#2F54EB）
 * 预警语义色：橙色（待确认）/ 红色（已预警）/ 绿色（安全）
 */
page {
  background: #F5F6FA;
  color: #1F2329;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* ===== 通用卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* ===== 通用按钮 ===== */
.btn {
  display: block;
  width: 100%;
  padding: 0 24rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
}
.btn::after {
  border: none; /* 去掉微信按钮默认的 1px 边框 */
}
.btn-primary {
  background: #2F54EB;
  color: #FFFFFF;
}
.btn-ghost {
  background: #F0F3FF;
  color: #2F54EB;
}
.btn-danger {
  background: #FFF1F0;
  color: #E5484D;
}

/* ===== 表单 ===== */
.form-item {
  margin-bottom: 32rpx;
}
.form-label {
  font-size: 28rpx;
  color: #4E5969;
  margin-bottom: 16rpx;
}
.required {
  color: #E5484D;
  margin-left: 4rpx;
}
.form-input {
  background: #F5F6FA;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}
.ph {
  color: #B4BCCC; /* 输入框占位符颜色 */
}
.form-hint {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ===== 通用单元格（label 左 / value 右） ===== */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}
.cell-label {
  font-size: 30rpx;
  color: #1F2329;
}
.cell-value {
  font-size: 28rpx;
  color: #86909C;
}

/* ===== 顶部警示横幅 ===== */
.banner {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
.banner--warn {
  background: #FFF7E8;
  color: #D46B08;
}
.banner--danger {
  background: #FFF1F0;
  color: #E5484D;
}
