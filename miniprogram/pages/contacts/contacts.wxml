<!--pages/contacts/contacts.wxml —— 紧急联系人列表：查看 / 编辑 / 删除 / 新增-->
<view class="page">

  <!-- 空状态 -->
  <view wx:if="{{!loading && list.length === 0}}" class="empty">
    <view class="empty-icon">📮</view>
    <view class="empty-text">还没有紧急联系人</view>
    <view class="empty-sub">添加你信任的人，失联时他们会收到预警邮件</view>
  </view>

  <!-- 联系人列表（点击进入编辑，"删除"按钮阻止冒泡单独响应） -->
  <view
    wx:for="{{list}}"
    wx:key="_id"
    class="card contact-item"
    bindtap="onEdit"
    data-id="{{item._id}}"
    data-name="{{item.name}}"
    data-email="{{item.email}}"
  >
    <view class="avatar">{{item.avatar}}</view>
    <view class="contact-info">
      <view class="contact-name">{{item.name}}</view>
      <view class="contact-email">{{item.email}}</view>
    </view>
    <view
      class="del-btn"
      catchtap="onDelete"
      data-id="{{item._id}}"
      data-name="{{item.name}}"
    >删除</view>
  </view>

  <view class="limit-hint" wx:if="{{list.length > 0}}">最多可添加 {{maxContacts}} 位紧急联系人</view>

  <!-- 底部新增按钮（固定悬浮，适配全面屏安全区） -->
  <view class="footer-bar">
    <button class="btn btn-primary" bindtap="onAdd">＋ 添加联系人</button>
  </view>
</view>
