/* pages/contacts/contacts.wxss —— 联系人列表页样式 */
.page {
  padding-bottom: 180rpx; /* 给底部固定按钮留出空间 */
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 80rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* ===== 联系人条目 ===== */
.contact-item {
  display: flex;
  align-items: center;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E8EDFF;
  color: #2F54EB;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.contact-info {
  flex: 1;
  min-width: 0;
}
.contact-name {
  font-size: 30rpx;
  font-weight: 500;
}
.contact-email {
  font-size: 24rpx;
  color: #86909C;
  margin-top: 6rpx;
  word-break: break-all; /* 邮箱过长时换行显示 */
}
.del-btn {
  font-size: 26rpx;
  color: #E5484D;
  padding: 12rpx 0 12rpx 24rpx;
  flex-shrink: 0;
}

.limit-hint {
  text-align: center;
  font-size: 22rpx;
  color: #B4BCCC;
  margin: 8rpx 0;
}

/* ===== 底部固定新增按钮 ===== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(245, 246, 250, 0.96);
}
.footer-bar .btn {
  margin-top: 0;
}
