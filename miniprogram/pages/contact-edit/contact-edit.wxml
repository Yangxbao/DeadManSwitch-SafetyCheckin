<!--pages/contact-edit/contact-edit.wxml —— 联系人添加/编辑表单-->
<view class="page">
  <view class="card">
    <view class="card-title">{{isEdit ? '编辑联系人' : '添加联系人'}}</view>

    <view class="form-item">
      <view class="form-label">姓名 <text class="required">*</text></view>
      <input
        class="form-input"
        value="{{name}}"
        bindinput="onNameInput"
        placeholder="如：张三 / 妈妈"
        maxlength="20"
        placeholder-class="ph"
      />
    </view>

    <view class="form-item">
      <view class="form-label">预警接收邮箱 <text class="required">*</text></view>
      <input
        class="form-input"
        value="{{email}}"
        bindinput="onEmailInput"
        placeholder="失联时预警邮件将发送到该邮箱"
        maxlength="60"
        placeholder-class="ph"
      />
      <view class="form-hint">请务必确认邮箱正确，建议保存后先自行测试收件</view>
    </view>

    <button class="btn btn-primary" loading="{{saving}}" bindtap="onSave">
      {{isEdit ? '保存修改' : '添加联系人'}}
    </button>
    <button wx:if="{{isEdit}}" class="btn btn-danger" bindtap="onDelete">删除该联系人</button>
  </view>
</view>
