# ================= 依赖目录 =================
node_modules/
**/node_modules/

# ================= 敏感信息（严禁提交） =================
# 邮箱 SMTP 授权码等密钥配置：
# 仓库中只保留 config.example.js 模板，
# 每人本地复制为 config.js 并填入自己的授权码
cloudfunctions/*/config.js
cloudfunctions/**/config.js

# 环境变量 / 本地密钥文件
.env
.env.*
*.local
*.pem
*.key

# ================= 微信开发者工具 =================
# 开发者工具本地个性化配置（含本机路径等）
project.private.config.json

# ================= 日志 =================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ================= 系统与编辑器 =================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ================= 打包产物 =================
*.zip
*.tar.gz
